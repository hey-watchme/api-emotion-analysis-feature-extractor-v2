# Hugging Face設定
HF_TOKEN=your-hugging-face-token-here

# API設定（将来用）
API_PORT=8016
SEGMENT_DURATION=10

# Supabase/AWS設定（本番必須）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=watchme-vault
FEATURE_COMPLETED_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/754724220380/watchme-feature-completed-queue

# SER job queue設定（/async-process 受付専用モード）
SER_JOB_QUEUE_ENABLED=true
SER_JOB_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/754724220380/watchme-ser-job-queue-v1.fifo
SER_JOB_QUEUE_WAIT_SECONDS=20
SER_JOB_QUEUE_VISIBILITY_TIMEOUT=600
